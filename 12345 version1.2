#include <WiFi.h>
#include <WebServer.h>
#include <Adafruit_Sensor.h>
#include <DHT.h>

#define DHTPIN 4       // GPIO 4
#define DHTTYPE DHT11  // DHT11

const char *ssid = "Smart Home";
WebServer server(80);
DHT dht(DHTPIN, DHTTYPE);

// ---- Stable reading cache ----
float cachedT = NAN;
float cachedH = NAN;
unsigned long lastRead = 0;
const unsigned long READ_INTERVAL = 2500; // DHT11 needs ~2s between reads

void updateSensor() {
  if (millis() - lastRead < READ_INTERVAL) return;
  lastRead = millis();

  float h = dht.readHumidity();
  float t = dht.readTemperature();

  if (isnan(h) || isnan(t)) {
    delay(50);
    h = dht.readHumidity();
    t = dht.readTemperature();
  }

  if (!isnan(h) && !isnan(t)) {
    cachedH = h;
    cachedT = t;
  }
}

void handleRoot() {
  updateSensor();

  String tempStr = isnan(cachedT) ? "--.-" : String(cachedT, 1);
  String humStr  = isnan(cachedH) ? "--.-" : String(cachedH, 1);

  String html = F("<!DOCTYPE html><html><head>");
  html += F("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">");
  html += F("<meta http-equiv=\"refresh\" content=\"3\">");
  html += F("<title>IBM MONITOR</title>");
  html += F("<style>");
  html += F("*{box-sizing:border-box;margin:0;padding:0;}");
  html += F("html,body{height:100%;width:100%;overflow:hidden;background:#000;}");
  html += F("body{");
  html += F("background:#000;");
  html += F("color:#33ff33;");
  html += F("font-family:'Courier New',Courier,monospace;");
  html += F("display:flex;justify-content:center;align-items:center;");
  html += F("text-shadow:0 0 6px #33ff33, 0 0 14px #1a8c1a;");
  html += F("position:relative;");
  html += F("}");

  // CRT vignette / edge shadow overlay
  html += F("body::before{");
  html += F("content:'';position:fixed;inset:0;pointer-events:none;z-index:10;");
  html += F("background:radial-gradient(ellipse at center,");
  html += F("rgba(0,0,0,0) 40%, rgba(0,0,0,0.55) 75%, rgba(0,0,0,0.95) 100%);");
  html += F("box-shadow:inset 0 0 120px 40px #000, inset 0 0 40px 10px rgba(0,0,0,0.9);");
  html += F("}");

  // Subtle scanlines
  html += F("body::after{");
  html += F("content:'';position:fixed;inset:0;pointer-events:none;z-index:9;");
  html += F("background:repeating-linear-gradient(");
  html += F("to bottom, rgba(0,255,0,0.03) 0px, rgba(0,255,0,0.03) 1px,");
  html += F("transparent 1px, transparent 3px);");
  html += F("}");

  html += F(".screen{");
  html += F("width:100%;height:100%;");
  html += F("display:flex;flex-direction:column;");
  html += F("justify-content:center;align-items:center;");
  html += F("padding:8vh 6vw;text-align:left;");
  html += F("}");

  html += F(".header{");
  html += F("font-size:clamp(14px,4vw,26px);");
  html += F("letter-spacing:4px;margin-bottom:6vh;");
  html += F("color:#33ff33;opacity:0.85;");
  html += F("}");

  html += F(".line{");
  html += F("font-size:clamp(22px,7vw,54px);");
  html += F("letter-spacing:2px;");
  html += F("margin:2.5vh 0;");
  html += F("width:100%;max-width:900px;");
  html += F("display:flex;justify-content:space-between;");
  html += F("}");

  html += F(".label{color:#22cc22;}");
  html += F(".value{color:#66ff66;text-shadow:0 0 8px #33ff33, 0 0 20px #1a8c1a;}");
  html += F(".err{color:#ff3333;text-shadow:0 0 8px #ff0000, 0 0 20px #8c0000;}");
  html += F(".unit{font-size:0.7em;opacity:0.85;margin-left:6px;}");
  html += F("</style></head><body>");

  html += F("<div class=\"screen\">");
  html += F("<div class=\"header\">&gt; IBM SYSTEM / TEMPERATURE &amp; HUMIDITY</div>");

  if (isnan(cachedT) || isnan(cachedH)) {
    html += F("<div class=\"line\"><span class=\"label\">TEMP</span>");
    html += F("<span class=\"err\">NO DATA</span></div>");
    html += F("<div class=\"line\"><span class=\"label\">HUMID</span>");
    html += F("<span class=\"err\">NO DATA</span></div>");
  } else {
    html += F("<div class=\"line\"><span class=\"label\">TEMP</span>");
    html += F("<span class=\"value\">");
    html += tempStr;
    html += F("<span class=\"unit\">&deg;C</span></span></div>");

    html += F("<div class=\"line\"><span class=\"label\">HUMID</span>");
    html += F("<span class=\"value\">");
    html += humStr;
    html += F("<span class=\"unit\">%</span></span></div>");
  }

  html += F("</div></body></html>");

  server.send(200, "text/html", html);
}

void setup() {
  Serial.begin(115200);

  dht.begin();
  delay(2000);

  updateSensor();
  lastRead = 0;

  WiFi.softAP(ssid);
  IPAddress IP = WiFi.softAPIP();

  Serial.println("\n--- Access Point Started ---");
  Serial.print("SSID: ");
  Serial.println(ssid);
  Serial.print("IP Address: ");
  Serial.println(IP);

  server.on("/", handleRoot);
  server.begin();
}

void loop() {
  server.handleClient();
}
